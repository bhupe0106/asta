# ---------------------------------------------------------------------------
# ASTA environment configuration. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# development | test | production
ASTA_ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ASTA_SECRET_KEY=change-me-to-a-long-random-value

# SQLite is the default for local development. When unset, the app resolves
# the database to <repo>/data/asta.db regardless of the working directory.
# A relative URL below is resolved from the process working directory.
# ASTA_DATABASE_URL=sqlite:///./data/asta.db
# PostgreSQL example:
# ASTA_DATABASE_URL=postgresql+psycopg://asta:password@localhost:5432/asta

# Comma-separated browser origins allowed to call the API.
ASTA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Provider routing: auto | ollama | demo
# auto  = prefer Ollama, fall back to the clearly labelled demo composer
# ollama = never fall back
# demo   = deterministic composer only
ASTA_PROVIDER_MODE=auto
ASTA_OLLAMA_BASE_URL=http://127.0.0.1:11434
ASTA_OLLAMA_MODEL=llama3.2
ASTA_ALLOW_DEMO_PROVIDER=true

# Research (optional). Providers: duckduckgo (default, no key), wikipedia, searxng, disabled.
ASTA_SEARCH_PROVIDER=duckduckgo
ASTA_SEARXNG_URL=

# Best-effort local code execution limits (not a hardened sandbox).
# Disable on any public deployment: ASTA_SANDBOX_ENABLED=false
ASTA_SANDBOX_ENABLED=true
ASTA_SANDBOX_TIMEOUT_SECONDS=10
ASTA_SANDBOX_MAX_OUTPUT_CHARS=8000

# Generated procedural SVG/media files.
ASTA_MEDIA_DIR=./data/media

# Uploads
ASTA_UPLOAD_DIR=./data/uploads
ASTA_MAX_UPLOAD_MB=20

ASTA_ENABLE_REGISTRATION=true
